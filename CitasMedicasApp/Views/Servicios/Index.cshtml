@{
    ViewData["Title"] = "Servicios";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4 text-center" style="color:#1dc8e9;">Servicios al Público</h1>
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1519821172143-1a9a5f16b8a4?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Consulta General">
                <div class="card-body text-center">
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Consulta General</h4>
                    <p class="card-text">Atención médica primaria para todas las edades.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1465101178521-c1a4c8a0f8f9?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Laboratorio Clínico">
                <div class="card-body text-center">
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Laboratorio Clínico</h4>
                    <p class="card-text">Análisis y estudios clínicos para diagnóstico.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Rayos X">
                <div class="card-body text-center">
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Rayos X</h4>
                    <p class="card-text">Servicios de radiología para estudios médicos.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd2b?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Urgencias">
                <div class="card-body text-center">
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Urgencias</h4>
                    <p class="card-text">Atención inmediata en casos de emergencia.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Farmacia">
                <div class="card-body text-center">
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Farmacia</h4>
                    <p class="card-text">Dispensación de medicamentos y asesoría farmacéutica.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1465101046530-73398c7f28ca?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Vacunación">
                <div class="card-body text-center">
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Vacunación</h4>
                    <p class="card-text">Aplicación de vacunas para prevención de enfermedades.</p>
                </div>
            </div>
        </div>
    </div>
</div>
