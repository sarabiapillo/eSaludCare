@{
    ViewData["Title"] = "Departamentos";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4 text-center" style="color:#1dc8e9;">Departamentos Médicos</h1>
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Medicina General">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">🩺</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Medicina General</h4>
                    <p class="card-text">Atención primaria, diagnóstico y seguimiento de enfermedades comunes.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1511174511562-5f7f18b874f8?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Pediatría">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">👩‍⚕️</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Pediatría</h4>
                    <p class="card-text">Atención médica especializada en bebés, niños y adolescentes.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1526256262350-7da7584cf5eb?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Ginecología y Obstetricia">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">❤️</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Ginecología y Obstetricia</h4>
                    <p class="card-text">Salud reproductiva femenina, control prenatal y partos.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1465101046530-73398c7f28ca?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Medicina Interna">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">💪</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Medicina Interna</h4>
                    <p class="card-text">Diagnóstico y tratamiento de enfermedades en adultos.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1514539079130-25950c84c8a2?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Odontología">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">🦷</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Odontología</h4>
                    <p class="card-text">Cuidado bucal, limpieza, empastes y tratamientos dentales.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1465101178521-c1a4c8a0f8f9?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Psicología / Psiquiatría">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">🧠</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Psicología / Psiquiatría</h4>
                    <p class="card-text">Salud mental, orientación emocional y manejo del estrés.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow border-0">
                <img src="https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&w=400&q=80" class="card-img-top" alt="Fisioterapia y Rehabilitación">
                <div class="card-body text-center">
                    <div style="font-size:2.5rem;">🩹</div>
                    <h4 class="card-title mb-2" style="color:#1dc8e9;">Fisioterapia y Rehabilitación</h4>
                    <p class="card-text">Recuperación funcional tras lesiones o cirugías.</p>
                </div>
            </div>
        </div>
    </div>
</div>
